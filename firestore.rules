rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /ciudades/{ciudad} {

      // Usuarios: cualquiera puede crear su propio perfil y leer perfiles
      // (se necesita leer para listar conductores/pasajeros). Solo el
      // panel admin (autenticado) puede editar créditos/bloqueo de otros.
      match /usuarios/{uid} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if request.auth != null
          || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['inactivo']));
      }

      // Alertas de vía (retenes, accidentes, patrulla, SOS): públicas
      match /alertas/{alertaId} {
        allow read, write: if true;
      }

      // Solicitudes de viaje (pasajeros)
      match /solicitudes/{solId} {
        allow read, write: if true;
      }

      // Encomiendas
      match /encomiendas/{encId} {
        allow read, write: if true;
      }

      // Chat de conductores
      match /chat/{msgId} {
        allow read, write: if true;
      }

      // Puntos de referencia de la ciudad — lectura pública,
      // escritura solo desde el panel admin
      match /puntos/{puntoId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      // Anuncios / publicidad — lectura pública, escritura solo admin
      match /anuncios/{anuncioId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Configuración global de la plataforma — lectura pública,
    // escritura solo desde el panel admin (autenticado)
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Todo lo demás: denegado por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
